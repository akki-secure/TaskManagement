# コピーして .env を作成し、値を設定する: cp .env.example .env
# .env は絶対にコミットしないこと

# PostgreSQL 管理ユーザー（コンテナ初期化専用。アプリは使用しない）
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=

# アプリ専用DBユーザー（最小権限）
DB_NAME=taskmanagement
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# JWT署名鍵（32文字以上。生成例: openssl rand -hex 32）
JWT_SECRET=
